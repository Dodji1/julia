{
  "components": {
    "schemas": {
      "AnswerFilters": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "const": "fiscal",
            "title": "Domain",
            "type": "string"
          },
          "jurisdiction": {
            "const": "BJ",
            "title": "Jurisdiction",
            "type": "string"
          }
        },
        "required": [
          "domain",
          "jurisdiction"
        ],
        "title": "AnswerFilters",
        "type": "object"
      },
      "AnswerRequest": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/AnswerFilters"
          },
          "question": {
            "maxLength": 4000,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "filters"
        ],
        "title": "AnswerRequest",
        "type": "object"
      },
      "AnswerResponse": {
        "additionalProperties": false,
        "properties": {
          "answer_markdown": {
            "title": "Answer Markdown",
            "type": "string"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AnswerSource"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "enum": [
              "answered",
              "insufficient_sources",
              "clarification_required"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "conversation_id",
          "status",
          "answer_markdown",
          "sources"
        ],
        "title": "AnswerResponse",
        "type": "object"
      },
      "AnswerSource": {
        "additionalProperties": false,
        "properties": {
          "article": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "citation_id": {
            "description": "Numéro utilisé dans [1], [2]…",
            "pattern": "^[1-9][0-9]*$",
            "title": "Citation Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "document_type": {
            "title": "Document Type",
            "type": "string"
          },
          "document_url": {
            "description": "Ouvre le PDF original, à la page citée (#page=N).",
            "title": "Document Url",
            "type": "string"
          },
          "excerpt": {
            "description": "Extrait exact relu dans la base documentaire, jamais généré.",
            "title": "Excerpt",
            "type": "string"
          },
          "is_ocr": {
            "title": "Is Ocr",
            "type": "boolean"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Livre › Chapitre › Section, quand il est connu.",
            "title": "Location"
          },
          "page": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "source_level": {
            "description": "1 texte officiel … 4 documentation secondaire.",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Source Level",
            "type": "integer"
          },
          "status": {
            "enum": [
              "en_vigueur",
              "archive",
              "a_verifier"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "citation_id",
          "chunk_id",
          "document_id",
          "title",
          "article",
          "page",
          "version",
          "location",
          "status",
          "source_level",
          "document_type",
          "excerpt",
          "document_url",
          "is_ocr"
        ],
        "title": "AnswerSource",
        "type": "object"
      },
      "DocumentListResponse": {
        "additionalProperties": false,
        "properties": {
          "corpus_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corpus Version"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            },
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "corpus_version",
          "documents"
        ],
        "title": "DocumentListResponse",
        "type": "object"
      },
      "DocumentSummary": {
        "additionalProperties": false,
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "document_type": {
            "title": "Document Type",
            "type": "string"
          },
          "document_url": {
            "title": "Document Url",
            "type": "string"
          },
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "is_ocr": {
            "title": "Is Ocr",
            "type": "boolean"
          },
          "source_level": {
            "title": "Source Level",
            "type": "integer"
          },
          "status": {
            "enum": [
              "en_vigueur",
              "archive",
              "a_verifier"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "document_id",
          "title",
          "domain",
          "country",
          "document_type",
          "source_level",
          "version",
          "status",
          "is_ocr",
          "chunk_count",
          "document_url"
        ],
        "title": "DocumentSummary",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FeedbackRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "rating": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating",
            "type": "string"
          },
          "request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "rating"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "corpus_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corpus Version"
          },
          "database": {
            "enum": [
              "ok",
              "down",
              "not_configured"
            ],
            "title": "Database",
            "type": "string"
          },
          "engine": {
            "title": "Engine",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "engine",
          "database",
          "corpus_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SearchHit": {
        "additionalProperties": false,
        "properties": {
          "article": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "document_url": {
            "title": "Document Url",
            "type": "string"
          },
          "exact_match": {
            "title": "Exact Match",
            "type": "boolean"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "is_ocr": {
            "title": "Is Ocr",
            "type": "boolean"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "relevance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relevance"
          },
          "source_level": {
            "title": "Source Level",
            "type": "integer"
          },
          "status": {
            "enum": [
              "en_vigueur",
              "archive",
              "a_verifier"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "title",
          "article",
          "page",
          "version",
          "location",
          "status",
          "source_level",
          "relevance",
          "exact_match",
          "excerpt",
          "document_url",
          "is_ocr"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/AnswerFilters"
          },
          "limit": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 4000,
            "minLength": 3,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "filters"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Assistante juridique sourcée : fiscalité du Bénin (V0).",
    "title": "Julia API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "État de l'API et de la base",
        "tags": [
          "exploitation"
        ]
      }
    },
    "/api/v1/answers": {
      "post": {
        "operationId": "create_answer_api_v1_answers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requête invalide"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Limite de débit ou quota du jour atteint"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erreur interne"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Fournisseur LLM indisponible"
          }
        },
        "summary": "Répondre à une question juridique à partir du corpus",
        "tags": [
          "answers"
        ]
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "list_documents_api_v1_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Corpus couvert par Julia",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/documents/{document_id}": {
      "get": {
        "operationId": "get_document_api_v1_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Document inconnu ou fichier absent"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/documents/{document_id}/file": {
      "get": {
        "operationId": "get_document_file_api_v1_documents__document_id__file_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Document inconnu ou fichier absent"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "PDF original (ajouter #page=N pour ouvrir à une page)",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/feedback": {
      "post": {
        "operationId": "create_feedback_api_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Avis de l'utilisateur sur une réponse (pouce levé ou baissé)",
        "tags": [
          "feedback"
        ]
      }
    },
    "/api/v1/search": {
      "post": {
        "operationId": "search_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Recherche seule, sans LLM (débogage et évaluation du retrieval)",
        "tags": [
          "équipe"
        ]
      }
    }
  }
}
