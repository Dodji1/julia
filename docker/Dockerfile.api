FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/home/julia/.cache/huggingface

WORKDIR /app

# PyTorch CPU : évite d'embarquer CUDA (plusieurs Go) sur un VPS sans GPU.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch
COPY requirements.txt requirements-ml.txt ./
RUN pip install -r requirements.txt -r requirements-ml.txt

RUN useradd --create-home julia && mkdir -p "$HF_HOME" && chown -R julia:julia /home/julia
COPY contracts ./contracts
COPY backend ./backend
COPY data/metadata ./data/metadata

USER julia
EXPOSE 8000
CMD ["uvicorn", "backend.app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
