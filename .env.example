# Copier en .env. Toutes les variables de l'API commencent par JULIA_.

# dev | prod  (prod refuse de démarrer sans moteur postgres, clé LLM, jeton admin et sel)
JULIA_ENV=dev
# fake : réponses de démonstration, sans base ni LLM | postgres : moteur réel
JULIA_ENGINE=fake

# Base locale lancée par docker compose (port 55432 pour ne pas gêner un PostgreSQL déjà installé).
# 127.0.0.1 plutôt que localhost : sous Windows, localhost tente d'abord IPv6 et perd 15 s par connexion.
POSTGRES_PASSWORD=julia-dev
JULIA_DB_PORT=55432
JULIA_DATABASE_URL=postgresql://julia:julia-dev@127.0.0.1:55432/julia
JULIA_DATA_RAW_DIR=data/raw

# Embeddings : BAAI/bge-m3 (nécessite requirements-ml.txt) ou test/hashing (sans PyTorch, qualité nulle)
JULIA_EMBEDDING_MODEL=BAAI/bge-m3
# none | cross_encoder (bge-reranker-v2-m3) — recalibrer JULIA_MIN_RELEVANCE si on l'active
JULIA_RERANKER=none
JULIA_MIN_RELEVANCE=0.45
JULIA_RETRIEVE_K=30
JULIA_CONTEXT_K=8
JULIA_REFERENCE_YEAR=2026
# Part maximale de chaque passage envoyée au LLM (l'extrait affiché reste complet)
JULIA_MAX_PASSAGE_CHARS=6000
# Longueur maximale vectorisée par BGE-M3 ; au-delà, seul le plein texte couvre la fin du chunk
JULIA_EMBEDDING_MAX_TOKENS=1024

# openai_compatible (DeepSeek…) | extractive : test de l'interface sans clé API, Julia cite les
# meilleurs passages sans rédiger de réponse (interdit en production)
JULIA_LLM_PROVIDER=openai_compatible

# LLM principal : DeepSeek (API compatible OpenAI), mode réflexion désactivé
JULIA_LLM_BASE_URL=https://api.deepseek.com
JULIA_LLM_API_KEY=
JULIA_LLM_MODEL=deepseek-flash
JULIA_LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# LLM de secours (facultatif), utilisé si le principal ne répond pas
JULIA_LLM_FALLBACK_BASE_URL=
JULIA_LLM_FALLBACK_API_KEY=
JULIA_LLM_FALLBACK_MODEL=
JULIA_LLM_FALLBACK_EXTRA_BODY={}

# Limites (accès public par QR code)
JULIA_RATE_LIMIT_CLIENT_PER_MINUTE=6
JULIA_RATE_LIMIT_CLIENT_PER_DAY=60
JULIA_RATE_LIMIT_IP_PER_MINUTE=120
JULIA_DAILY_ANSWER_BUDGET=5000

# Production : jeton pour /api/v1/search, sel pour anonymiser les IP dans les traces
JULIA_ADMIN_TOKEN=
JULIA_TRACE_SALT=
